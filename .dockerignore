.git
.gitignore

# Documentación
docs/
Manuales/
*.md
!README.md

# Tests
__tests__
*.test.ts
*.test.tsx
*.spec.ts
*.spec.tsx

# Docker (no necesitamos recursión)
docker/images/
docker/scripts/
Dockerfile
docker-compose*.yml
.dockerignore

